{
  "name": "cursor-ssh-mcp",
  "version": "1.3.20",
  "description": "User-level Cursor MCP + Activity Bar SSH panel: saved hosts, key auth, SFTP, terminal",
  "type": "module",
  "bin": {
    "cursor-ssh-mcp": "./src/index.js",
    "cursor-ssh-mcp-ui": "./src/ui-cli.js"
  },
  "main": "./src/index.js",
  "scripts": {
    "start": "node ./src/index.js",
    "ui": "node ./src/ui-cli.js",
    "test:smoke": "node ./scripts/smoke-hosts.js",
    "test:e2e": "node ./scripts/smoke-e2e.mjs",
    "test:delete": "node ./scripts/smoke-delete-host.mjs",
    "extension:package": "cd extension && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository -o ../cursor-ssh-mcp.vsix"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ssh2": "^1.16.0",
    "ws": "^8.18.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zod": "^3.24.2"
  },
  "files": [
    "src",
    "ui",
    "extension",
    "examples",
    "scripts",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh-CN.md",
    "SECURITY.md",
    "SECURITY.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "cursor",
    "mcp",
    "ssh",
    "termius",
    "sftp",
    "xterm"
  ],
  "author": "A95monster",
  "license": "MIT",
  "homepage": "https://github.com/A95monster/cursor-lab/tree/main/mcp/cursor-ssh-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A95monster/cursor-lab.git",
    "directory": "mcp/cursor-ssh-mcp"
  },
  "bugs": {
    "url": "https://github.com/A95monster/cursor-lab/issues"
  },
  "devDependencies": {
    "playwright": "^1.49.1"
  }
}
