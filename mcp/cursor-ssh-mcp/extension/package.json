{
  "name": "cursor-ssh-mcp",
  "displayName": "Cursor SSH (MCP)",
  "description": "SSH workbench in the editor center: hosts on the left, SFTP/terminal layout on the right.",
  "version": "1.3.20",
  "publisher": "cursor-ssh-mcp",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:cursorSshMcp.panel",
    "onCommand:cursorSshMcp.focusPanel",
    "onCommand:cursorSshMcp.openEditor",
    "onCommand:cursorSshMcp.openExternal",
    "onCommand:cursorSshMcp.restartUi"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursor-ssh-mcp",
          "title": "SSH",
          "icon": "media/ssh.svg"
        }
      ]
    },
    "views": {
      "cursor-ssh-mcp": [
        {
          "type": "webview",
          "id": "cursorSshMcp.panel",
          "name": "主机",
          "icon": "media/ssh.svg",
          "retainContextWhenHidden": true
        }
      ]
    },
    "commands": [
      {
        "command": "cursorSshMcp.openEditor",
        "title": "SSH: 在中间打开工作台",
        "category": "SSH"
      },
      {
        "command": "cursorSshMcp.focusPanel",
        "title": "SSH: 打开工作台",
        "category": "SSH"
      },
      {
        "command": "cursorSshMcp.openExternal",
        "title": "SSH: 在浏览器打开",
        "category": "SSH"
      },
      {
        "command": "cursorSshMcp.restartUi",
        "title": "SSH: 重启 UI 服务",
        "category": "SSH"
      }
    ],
    "configuration": {
      "title": "Cursor SSH MCP",
      "properties": {
        "cursorSshMcp.uiPort": {
          "type": "number",
          "default": 3847,
          "description": "Local UI server port (must match CURSOR_SSH_MCP_UI_PORT if set for MCP)."
        },
        "cursorSshMcp.packageRoot": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the cursor-ssh-mcp package root. Leave empty to use the sibling folder of this extension."
        }
      }
    }
  }
}
